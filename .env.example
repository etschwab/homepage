ADMIN_USERNAME=etienne
ADMIN_PASSWORD_HASH=replace-with-argon2-hash
# Eigenes Login für den Admin-Bereich (/admin/login). Nicht weitergeben.
EDITOR_USERNAME=etienne-admin
EDITOR_PASSWORD_HASH=replace-with-argon2-hash
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Wird von Vercel gesetzt, sobald ein Blob Store mit dem Projekt verbunden ist
# (BLOB_STORE_ID oder bei älteren Stores BLOB_READ_WRITE_TOKEN).
# Lokal leer lassen: der Admin speichert dann in .data/cms.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
